<?xml version="1.0" encoding="utf-8"?>
<!--
    Quy tắc sao lưu cho Android 12+ (API 31+).
    Loại trừ phiên đăng nhập (access/refresh token) và cấu hình server có thể chứa khóa cũ dạng thô,
    để bản sao lưu đám mây hoặc chuyển dữ liệu sang máy mới không mang theo phiên đăng nhập.
    Các bí mật mã hóa bằng Android Keystore nằm trong noBackupFilesDir nên vốn không được sao lưu.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="epubpro_auth_prefs.xml" />
        <exclude domain="sharedpref" path="server_settings_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="epubpro_auth_prefs.xml" />
        <exclude domain="sharedpref" path="server_settings_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
